+  int _integer(Map<String, dynamic> data, String key) {
+    final n = data[key];
+    if (n is! int || n < 0) throw const ApiException('统一告警游标无效');
+    return n;
+  }
+
+  Future<AlertSyncResult> synchronize() async {
