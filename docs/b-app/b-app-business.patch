+      expect(find.byType(EventDetailScreen), findsNothing);
+      expect(find.text('这条通知属于其他后端或家庭，请切换到原连接后查看'), findsOneWidget);
+      expect(t.takeException(), isNull);
+      await t.pumpWidget(const SizedBox.shrink());
+    }),
+  );
+}
